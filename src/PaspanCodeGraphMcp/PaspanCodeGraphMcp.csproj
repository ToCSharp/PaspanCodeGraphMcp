<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>PaspanCodeGraphMcp</RootNamespace>
    <AssemblyName>paspan-code-graph-mcp</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>paspan-code-graph-mcp</ToolCommandName>
    <PackageId>PaspanCodeGraphMcp</PackageId>
    <!-- Keep in step with .mcp/server.json (checked by PackagingTests) -->
    <Version>0.2.4</Version>
    <Description>Read-only MCP server for C# and C++ code analysis by AI agents: declarations, type hierarchy, references, call graph and GraphRAG retrieval (search, context within a token budget, impact of a change), built with PaspanParsers instead of Roslyn or clang and without MSBuild.</Description>
    <Authors>ToCSharp</Authors>
    <Copyright>Copyright (c) 2026, ToCSharp</Copyright>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <PackageTags>mcp;mcp-server;csharp;cpp;c++;code-graph;graphrag;call-graph;ai-agents;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/ToCSharp/PaspanCodeGraphMcp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ToCSharp/PaspanCodeGraphMcp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- A dotnet tool that MCP clients can also find as an MCP server on NuGet (dnx PaspanCodeGraphMcp) -->
    <PackageType>McpServer</PackageType>
    <!-- Also a single NativeAOT binary: dotnet publish -c Release -r <rid> -p:PublishAot=true -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <!-- The reference pass walks syntax nodes through their public properties -->
    <TrimmerRootAssembly Include="PaspanParsers" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include=".mcp\server.json" Pack="true" PackagePath=".mcp" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PaspanCodeGraph.Workspace\PaspanCodeGraph.Workspace.csproj" />
    <ProjectReference Include="..\PaspanCodeGraph.Search\PaspanCodeGraph.Search.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PaspanCodeGraph.Tests" />
  </ItemGroup>
</Project>
